# Supabase (required for auth + database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: for server-side Supabase client (e.g. admin)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL (OAuth redirects, canonical URLs, sitemap). Production: https://grabmoda.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Product images base URL (e.g. your existing site). Relative paths and placeholders use this origin.
NEXT_PUBLIC_PRODUCT_IMAGE_ORIGIN=https://noofoxxx.local

# Admin emails (comma-separated); else resolved from users where role=admin (requires SUPABASE_SERVICE_ROLE_KEY)
# ADMIN_EMAIL=admin@example.com

# Optional: trigger admin_high_value_order when order total >= this (USD)
# EMAIL_HIGH_VALUE_THRESHOLD=500

# Optional: home CTA “Join our Telegram community” — e.g. https://t.me/+abc123 or https://t.me/grabmoda
# NEXT_PUBLIC_TELEGRAM_GROUP_URL=

# Email automation
# RESEND_API_KEY=
# EMAIL_FROM="GrabModa <onboarding@resend.dev>"
# EMAIL_DISPATCH_SECRET=
# CRON_SECRET=

# Cloudflare Turnstile (bot protection on login, signup, checkout)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Guardarian card-to-crypto checkout
# NEXT_PUBLIC_GUARDARIAN_BASE_URL=https://guardarian.com/buy-crypto-with-card
# GUARDARIAN_BASE_URL=https://guardarian.com/buy-crypto-with-card
# GUARDARIAN_PARTNER_API_TOKEN=
# GUARDARIAN_PARTNER_ID=
# GUARDARIAN_DEFAULT_FIAT=USD
# GUARDARIAN_DEFAULT_CRYPTO=USDT
# GUARDARIAN_DESTINATION_ADDRESS=
# GUARDARIAN_WEBHOOK_SECRET=
# GUARDARIAN_WEBHOOK_SIGNATURE_SECRET=
